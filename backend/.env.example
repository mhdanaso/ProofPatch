# Optional AI enrichment; deterministic analysis works without a key.
AI_API_URL=https://openrouter.ai/api/v1/chat/completions
AI_API_KEY=your_key_here
AI_MODEL=openrouter/free

# Required to accept authenticated Prometheus Alertmanager webhooks.
# Generate a long random value and configure the same value in Alertmanager.
PROOFPATCH_WEBHOOK_TOKEN=replace_with_a_long_random_secret

# Required to accept signed GitHub change webhooks.
# Use the same value as the webhook Secret in GitHub repository settings.
PROOFPATCH_GITHUB_WEBHOOK_SECRET=replace_with_a_long_random_secret

# Optional. Map repository names to the service field used by your incidents.
# Without a mapping, the repository name is used as the service name.
# PROOFPATCH_GITHUB_SERVICES=mhdanaso/patchproof=demo-checkout

# Optional. Defaults to proofpatch.sqlite3 beside the backend source files.
# On a host with a persistent volume, set this to the mounted volume path.
# PROOFPATCH_DB_PATH=/var/data/proofpatch.sqlite3
